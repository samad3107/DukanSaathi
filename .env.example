# Paytm gateway
PAYTM_ENV=staging
PAYTM_MID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CALLBACK_URL=http://127.0.0.1:8000/paytm/callback/
# Used only when gateway credentials are absent
PAYTM_UPI_VPA=your-store@paytm
# During testing, all Udhaar reminders are sent to this number instead of the customer's number.
WHATSAPP_TEST_NUMBER=+919959364017

# Optional integrations
GEMINI_API_KEY=your_gemini_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=
TWILIO_SMS_NUMBER=
# During voice-call testing, calls are sent here instead of the customer's number.
VOICE_TEST_NUMBER=
# During SMS testing, messages are sent here instead of the customer's number.
SMS_TEST_NUMBER=
